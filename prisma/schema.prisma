generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
  LEGENDARY
}

enum ItemType {
  WEAPON
  EQUIPMENT
  CONSUMABLE
  TOOL
  LOOT
  CONTAINER
  SPELL
  FEAT
}

enum UserRole {
  PLAYER
  DM
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

model Item {
  id              String     @id @default(uuid())
  image           String
  name            String
  description     String
  rarity          ItemRarity
  type            ItemType
  price           Int        @default(0)
  deal            Boolean    @default(false)
  discountPercent Int        @default(0)
  stock           Int

  // Foundry D&D 5e item data for direct import.
  foundryItemData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews   Review[]
  purchases Purchase[]
}

model Review {
  id     String @id @default(uuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  authorName String
  content    String

  createdAt DateTime @default(now())

  @@unique([itemId, userId])
  @@index([userId])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(PLAYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions              Session[]
  characters            Character[]
  reviews               Review[]
  pairingCodes          FoundryPairingCode[]
  authCodes             AuthCode[]
  dmImpersonationTokens DmImpersonationToken[]
  dmWorlds              KatastroWorld[]
  vaultLikes            VaultLike[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Character {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  foundryWorldId String?
  foundryActorId String?

  creditBalance Int @default(0)

  katastroWorldId String?
  katastroWorld   KatastroWorld? @relation(fields: [katastroWorldId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases           Purchase[]
  apiTokens           CharacterApiToken[]
  impersonationTokens DmImpersonationToken[]
  authCodes           AuthCode[]
  foundryLinkRequests FoundryLinkRequest[]

  @@unique([foundryWorldId, foundryActorId])
  @@index([userId])
  @@index([katastroWorldId])
}

model Purchase {
  id String @id @default(uuid())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  itemName String

  // Total purchase price in copper pieces.
  priceGp Int

  // Number of copies purchased.
  quantity Int @default(1)

  createdAt DateTime @default(now())

  status        PurchaseStatus @default(PENDING)
  failureReason String?

  // ID of the Item document created in Foundry.
  foundryItemId String?

  // Client-generated key used to make purchase requests idempotent.
  idempotencyKey String @unique

  @@index([characterId])
  @@index([itemId])
  @@index([createdAt])
  @@index([status])
}

model KatastroWorld {
  id String @id @default(uuid())

  // Hashed world secret. Raw secret is returned only during pairing.
  worldSecretHash String @unique

  // One Foundry world maps to one Harkonians world.
  foundryWorldId String @unique

  dmUserId String
  dmUser   User   @relation(fields: [dmUserId], references: [id])

  createdAt DateTime @default(now())

  characters   Character[]
  pairingCodes FoundryPairingCode[]
  linkRequests FoundryLinkRequest[]

  @@index([dmUserId])
}

model FoundryPairingCode {
  id String @id @default(uuid())

  codeHash String @unique

  katastroWorldId String?
  katastroWorld   KatastroWorld? @relation(fields: [katastroWorldId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([codeHash])
  @@index([userId])
  @@index([katastroWorldId])
  @@index([expiresAt])
}

model FoundryLinkRequest {
  id            String @id @default(uuid())
  requestIdHash String @unique

  foundryActorId String
  foundryWorldId String

  katastroWorldId String
  katastroWorld   KatastroWorld @relation(fields: [katastroWorldId], references: [id])

  // Character selected/approved in the browser.
  authorizedCharacterId String?
  authorizedCharacter   Character? @relation(fields: [authorizedCharacterId], references: [id])

  authorizedAt DateTime?

  // Set after Foundry exchanges the authorization for credentials.
  used Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([foundryActorId, foundryWorldId])
  @@index([katastroWorldId])
  @@index([authorizedCharacterId])
  @@index([expiresAt])
}

model CharacterApiToken {
  id String @id @default(uuid())

  // Hashed token. Raw token is only returned to Foundry.
  tokenHash String @unique

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([characterId])
  @@index([expiresAt])
}

model AuthCode {
  id String @id @default(uuid())

  codeHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id])

  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([characterId])
  @@index([expiresAt])
}

model DmImpersonationToken {
  id String @id @default(uuid())

  tokenHash String @unique

  dmUserId String
  dmUser   User   @relation(fields: [dmUserId], references: [id])

  characterId String
  character   Character @relation(fields: [characterId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([dmUserId])
  @@index([characterId])
}

model AuditLog {
  id String @id @default(uuid())

  userId String

  action String

  targetType String?
  targetId   String?

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model VaultItem {
  id        String   @id @default(uuid())
  image     String
  quote     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes VaultLike[]

  @@index([createdAt])
}

model VaultLike {
  id          String    @id @default(uuid())
  vaultItemId String
  vaultItem   VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([vaultItemId, userId])
  @@index([vaultItemId])
  @@index([userId])
}
