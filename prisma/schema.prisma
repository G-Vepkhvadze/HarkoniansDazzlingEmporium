generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
  LEGENDARY
}

enum ItemType {
  WEAPON
  ARMOR
  ACCESSORY
  SCROLL
  POTION
}

enum UserRole {
  PLAYER
  DM
}

model Item {
  id          String      @id @default(uuid())
  image       String
  name        String
  description String
  rarity      ItemRarity
  type        ItemType
  price       Int         @default(0)
  deal        Boolean     @default(false)
  discountPercent Int     @default(0)
  stock       Int

  // Foundry D&D 5e item data for direct import
  // Stores complete Foundry item structure as JSON
  foundryItemData Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews Review[]
  purchases Purchase[]
}

model Review {
  id        String   @id @default(uuid())
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName String
  content   String

  createdAt DateTime @default(now())

  @@unique([itemId, userId])
  @@index([userId])
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(PLAYER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  sessions Session[]
  characters Character[]
  reviews Review[]
  pairingCodes FoundryPairingCode[]
  authCodes AuthCode[]
  dmImpersonationTokens DmImpersonationToken[]
  dmWorlds KatastroWorld[]  // Worlds where this user is the DM
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Character {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  foundryWorldId String?
  foundryActorId String?
  creditBalance Int       @default(0)

  // Link to Katastro world for multi-world support
  katastroWorldId String?
  katastroWorld   KatastroWorld? @relation(fields: [katastroWorldId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  purchases Purchase[]
  apiTokens CharacterApiToken[]
  impersonationTokens DmImpersonationToken[]
  authCodes AuthCode[]  // Auth codes that pre-selected this character

  @@unique([foundryWorldId, foundryActorId])
  @@index([userId])
  @@index([katastroWorldId])
}

model Purchase {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName    String
  priceCp     Int
  createdAt   DateTime @default(now())

  // Purchase status for Foundry integration
  status       String    @default("PENDING")
  failureReason String?

  // Foundry item ID created from this purchase
  foundryItemId String?

  // Idempotency key for preventing duplicate purchase processing
  // Unique across all purchases - prevents same request from being processed twice
  idempotencyKey String?

  @@index([characterId])
  @@index([itemId])
  @@index([createdAt])
  @@unique([idempotencyKey])
}

// =============================================
// FOUNDRY INTEGRATION MODELS
// =============================================

// Represents the paired Katastro Foundry World
// For our deployment: ONE campaign (Katastro), ONE world
model KatastroWorld {
  id              String   @id @default(uuid())

  // HASHED world secret (bcrypt) - raw returned once to Foundry module
  // The module must store this securely in Foundry world settings
  worldSecretHash String   @unique

  // Foundry's internal world ID (for reference/debugging)
  foundryWorldId  String

  // The Harkonians User who is the DM for this world
  dmUserId        String
  dmUser          User     @relation(fields: [dmUserId], references: [id])

  createdAt       DateTime @default(now())

  // Relations
  characters      Character[]
  pairingCodes    FoundryPairingCode[]
  linkRequests    FoundryLinkRequest[]

  @@index([foundryWorldId])
  @@index([dmUserId])
}

// One-time codes for initial world pairing (DM only)
// Generated by Harkonians, displayed to DM, entered in Foundry
model FoundryPairingCode {
  id           String   @id @default(uuid())

  // HASHED code (bcrypt) - human-readable format like "KAT-7X9-B2Y-4Q8"
  codeHash     String   @unique

  // The world this code pairs to (null for new world creation)
  katastroWorldId String?
  katastroWorld   KatastroWorld? @relation(fields: [katastroWorldId], references: [id])

  // User who generated this code (must be DM)
  userId       String
  user         User     @relation(fields: [userId], references: [id])

  used         Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([codeHash])
  @@index([userId])
  @@index([katastroWorldId])
  @@index([expiresAt])
}

// Server-generated requests for character linking
// Created when Foundry module requests a link, used during browser flow
model FoundryLinkRequest {
  id              String   @id @default(uuid())

  // HASHED request ID (bcrypt) - server-generated, returned to Foundry
  requestIdHash   String   @unique

  // Foundry context from the linking request
  foundryActorId  String
  foundryWorldId  String

  // Harkonians world this links to
  katastroWorldId String
  katastroWorld   KatastroWorld @relation(fields: [katastroWorldId], references: [id])

  used           Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([foundryActorId, foundryWorldId])
  @@index([katastroWorldId])
  @@index([expiresAt])
}

// Character-scoped API tokens for Foundry module
// Allows Foundry to make authenticated requests on behalf of a character
model CharacterApiToken {
  id           String   @id @default(uuid())

  // HASHED token (bcrypt) - never store raw
  tokenHash    String   @unique

  // Character this token grants access to
  characterId  String
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([characterId])
  @@index([expiresAt])
}

// Short-lived auth codes for browser-to-Foundry handoff
// Used during character linking flow
model AuthCode {
  id           String   @id @default(uuid())

  // HASHED code (bcrypt)
  codeHash     String   @unique

  // Authenticated user who created this code
  userId       String
  user         User     @relation(fields: [userId], references: [id])

  // Optional: pre-selected character (from browser flow)
  characterId  String?
  character    Character? @relation(fields: [characterId], references: [id])

  used         Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([characterId])
  @@index([expiresAt])
}

// DM impersonation tokens for testing
// Allows DM to temporarily act as a specific character
model DmImpersonationToken {
  id           String   @id @default(uuid())

  // HASHED token (bcrypt)
  tokenHash    String   @unique

  // DM who created this token
  dmUserId     String
  dmUser       User     @relation(fields: [dmUserId], references: [id])

  // Character being impersonated
  characterId  String
  character    Character @relation(fields: [characterId], references: [id])

  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([dmUserId])
  @@index([characterId])
  @@index([expiresAt])
}

// Audit logging for sensitive operations
// Tracks all security-relevant actions for review
model AuditLog {
  id          String   @id @default(uuid())

  // User who performed the action
  // For impersonation, this is the DM user, NOT the character's user
  userId      String

  // Action type
  action      String   // e.g., "LOGIN", "LOGOUT", "PURCHASE", "PAIR_WORLD",
                          // "IMPERSONATE_START", "IMPERSONATE_END", "GRANT_CREDIT"

  // What was affected
  targetType  String?  // e.g., "Character", "Purchase", "Item", "World"
  targetId    String?  // ID of the affected entity

  // Additional context (metadata about the action)
  metadata    Json?    // e.g., { oldBalance, newBalance, characterId, itemId }

  // Request context for security review
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
