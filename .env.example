# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase Storage (for item images)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Initial DM user credentials (for seeding)
# IMPORTANT: Set these to secure values in production!
# These are only used for initial database seeding.
# After the first seed, you can remove these or change them.
INITIAL_DM_USERNAME=your-dm-username
INITIAL_DM_PASSWORD=your-secure-password

# Session configuration
# Optional: Set a session secret for additional security
SESSION_SECRET=your-session-secret-key
