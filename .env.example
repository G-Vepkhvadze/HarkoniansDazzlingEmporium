# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase Configuration
# URL for Supabase project (used for storage and realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase publishable key (safe for browser/VTT realtime clients)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase JWT secret (for signing custom JWTs for Realtime authorization)
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# Initial DM user credentials (for seeding)
# IMPORTANT: Set these to secure values in production!
# These are only used for initial database seeding.
# After the first seed, you can remove these or change them.
INITIAL_DM_USERNAME=your-dm-username
INITIAL_DM_PASSWORD=your-secure-password

# Session configuration
# Optional: Set a session secret for additional security
SESSION_SECRET=your-session-secret-key
